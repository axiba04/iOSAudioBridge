<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iOSAudioBridge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../build/native/bin/AudioCore.dll" Link="AudioCore.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/bin/AudioCore.dll')" />
    <None Include="../../build/native/bin/AudioBridge.UsbRestore.exe" Link="AudioBridge.UsbRestore.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/bin/AudioBridge.UsbRestore.exe')" />
    <None Include="../../build/native/bin/libusb0.dll" Link="libusb0.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/native/bin/libusb0.dll')" />
  </ItemGroup>
</Project>
