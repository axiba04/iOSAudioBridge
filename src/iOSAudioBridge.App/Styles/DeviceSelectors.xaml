<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Explicit text colors prevent the application's light TextBlock style from leaking into selectors. -->
  <DataTemplate x:Key="DeviceDisplayTemplate">
    <TextBlock Text="{Binding Display}" Foreground="#162033" FontSize="14"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" />
  </DataTemplate>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#162033" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE" /></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#BFDBFE" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Foreground" Value="#162033" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#94A3B8" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" IsTabStop="False" ClickMode="Press"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#334155" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="10,7,38,7" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border Background="#F8FAFC" BorderBrush="#64748B" BorderThickness="1" CornerRadius="4" Padding="2"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#60A5FA" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#2563EB" /></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Background" Value="#E2E8F0" />
              <Setter Property="BorderBrush" Value="#64748B" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
