diff --git a/cmake-includes/GitVersion.cmake b/cmake-includes/GitVersion.cmake
index 33d983e..7ddbd9a 100644
--- a/cmake-includes/GitVersion.cmake
+++ b/cmake-includes/GitVersion.cmake
@@ -1,10 +1,13 @@
 # Read version from git tag and write it to VERSION file
-find_package(Git)
+if (NOT DEFINED FOOBAR_VERSION OR NOT DEFINED FOOBAR_HASH)
+    find_package(Git)
+endif ()
 
-if (GIT_EXECUTABLE)
+if (GIT_EXECUTABLE AND NOT DEFINED FOOBAR_VERSION)
     # Generate a git-describe version string from Git repository tags
     execute_process(
             COMMAND ${GIT_EXECUTABLE} describe --tags --abbrev=0
+            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
             OUTPUT_VARIABLE GIT_DESCRIBE_VERSION
             RESULT_VARIABLE GIT_DESCRIBE_ERROR_CODE
             OUTPUT_STRIP_TRAILING_WHITESPACE
@@ -13,8 +16,12 @@ if (GIT_EXECUTABLE)
         set(FOOBAR_VERSION ${GIT_DESCRIBE_VERSION})
         message(STATUS "Using the version \"${FOOBAR_VERSION}\".")
     endif ()
+endif ()
+
+if (GIT_EXECUTABLE AND NOT DEFINED FOOBAR_HASH)
     execute_process(
             COMMAND ${GIT_EXECUTABLE} log -1 --format=%h
+            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
             OUTPUT_VARIABLE GIT_CURRENT_HASH
             RESULT_VARIABLE GIT_HASH_ERROR_CODE
             OUTPUT_STRIP_TRAILING_WHITESPACE
@@ -35,8 +42,9 @@ endif ()
 
 string(REPLACE "v" "" FOOBAR_VERSION_WITHOUT_V "${FOOBAR_VERSION}")
 
-file(WRITE VERSION "${FOOBAR_VERSION_WITHOUT_V}")
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/VERSION" "${FOOBAR_VERSION_WITHOUT_V}")
 
 add_definitions(-DZL_PLUGIN_CURRENT_VERSION="${FOOBAR_VERSION_WITHOUT_V}")
 
 add_definitions(-DZL_PLUGIN_CURRENT_HASH="${FOOBAR_HASH}")
+
