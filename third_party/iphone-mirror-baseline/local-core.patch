@@ -437,9 +437,65 @@ void test_session_protocol() {
         "session emits the final HPD0 after release notifications");
 }
 
+void test_usb_audio_only_protocol() {
+    using namespace iPhoneMirror::quicktime;
+    SessionProtocol session(SessionOptions{.request_video = false});
+    auto event = session.process(decode_framed(make_ping()));
+    check(event.outbound.size() == 1, "audio-only replies to PING");
+    event = session.process(decode_framed(read_fixture(
+        "fixtures/quicktime_video_hack/cwpa-request1")));
+    check(event.outbound.size() == 2 &&
+        decode_framed(event.outbound[0]).kind == PacketKind::Reply &&
+        decode_framed(event.outbound[1]).subtype == fourcc('h', 'p', 'a', '1'),
+        "audio-only negotiates audio without advertising HPD1");
+    event = session.process(decode_framed(read_fixture(
+        "fixtures/quicktime_video_hack/afmt-request")));
+    check(session.negotiated_audio() && event.outbound.size() == 1 &&
+        event.outbound[0] == read_fixture("fixtures/quicktime_video_hack/afmt-reply"),
+        "audio-only retains normal AFMT negotiation");
+    const auto eat = parse_payload(read_fixture("fixtures/quicktime_video_hack/asyn-eat"));
+    event = session.process(eat);
+    check(event.audio_sample && event.state == SessionState::Streaming &&
+        session.audio_packets() == 1 && session.video_frames() == 0 &&
+        session.video_bytes() == 0, "audio alone enters streaming with zero video");
+    check(session.begin_display_reconfigure(1920, 1080).empty() &&
+        session.complete_display_reconfigure().empty(),
+        "orientation/refresh cannot re-enable an audio-only display");
+    const auto stop = session.stop_messages();
+    check(stop.size() == 1 && decode_framed(stop[0]).subtype == fourcc('h', 'p', 'a', '0'),
+        "pure audio session releases only the audio stream");
+    event = session.process(eat);
+    check(event.state == SessionState::Stopping, "late audio preserves stopping state");
+    check(session.complete_stop_messages().empty(), "audio-only has no final display release");
+    event = session.process(eat);
+    check(event.state == SessionState::Stopped, "late audio preserves stopped state");
+
+    session.reset();
+    check(session.audio_packets() == 0 && session.video_frames() == 0 &&
+        session.video_bytes() == 0, "audio-only reset clears all media counters");
+    event = session.process(decode_framed(read_fixture(
+        "fixtures/quicktime_video_hack/cvrp-request")));
+    check(event.outbound.size() == 1 && decode_framed(event.outbound[0]).kind == PacketKind::Reply,
+        "unsolicited video clock is acknowledged without NEED");
+    const auto feed = decode_framed(read_fixture("fixtures/quicktime_video_hack/asyn-feed"));
+    event = session.process(feed);
+    check(!event.video_sample && event.outbound.empty() && !event.warning.empty() &&
+        session.video_frames() == 1 && session.video_bytes() == feed.payload.size(),
+        "unsolicited video is counted without decoding or requesting more video");
+    check(event.state != SessionState::Streaming, "unrequested video cannot mark audio ready");
+    check(session.stop_messages().size() == 2 && session.complete_stop_messages().size() == 1,
+        "unexpected device video is also released during teardown");
+}
